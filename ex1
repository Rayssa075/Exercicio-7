#include <iostream>
using namespace std;

int main() {
    int matriz[2][4];
    int somaPares = 0;
    int qtdPares = 0;
    for (int i = 0; i < 2; i++) {
        for (int j = 0; j < 4; j++) {
            cout << "Digite o valor para [" << i << "][" << j << "]: ";
            cin >> matriz[i][j];
        }
    }

    cout << "\n--- Resultados ---" << endl;

    for (int i = 0; i < 2; i++) {
        int contEntre12e20 = 0; // Zera para cada nova linha

        for (int j = 0; j < 4; j++) {
            if (matriz[i][j] >= 12 && matriz[i][j] <= 20) {
                contEntre12e20++;
            }

            if (matriz[i][j] % 2 == 0) {
                somaPares += matriz[i][j];
                qtdPares++;
            }
        }
        cout << "Linha " << i << " tem " << contEntre12e20 << " elementos entre 12 e 20." << endl;
    }

   
    if (qtdPares > 0) {
        float media = (float)somaPares / qtdPares;
        cout << "\nMedia dos elementos pares: " << media << endl;
    } else {
        cout << "\nNao foram digitados numeros pares." << endl;
    }

    return 0;
}
