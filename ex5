#include <iostream>
using namespace std;
int main(){
int m1[4][3], m2[3][4], m3[4][4];
    
cout<<"Insira os valores da primeira matriz: ";
     
    for(int i = 0; i<4; i++){
        for(int j=0; j<3; j++){
            cin>>m1[i][j];
        }
    }
    
cout<<"Insira os valores da segunda matriz: ";
    for(int i=0; i<3; i++){
        for(int j=0; j<4; j++){
            cin>>m2[i][j];
        }
    }
    
    for(int i=0; i<4; i++){
        for(int j=0; j<4; j++){
            m3[i][j]=0;
            for(int k=0; k<3; k++){
                m3[i][j]=m3[i][j]+(m1[i][j]*m2[i][j]);
            }
        }
    }
cout<<"A multiplicação das matrizes é: ";
    for(int i=0; i<4; i++){
        for(int j=0; j<4; j++){
            cout<<m3[i][j]<<" ";
        }
    } 
return 0;
}
