#include <iostream>
using namespace std;
int main(){
int m1[4][4], m2[4][4], soma[4][4];
    
cout<<"Insira os valores da primeira matriz: ";
     
    for(int i = 0; i<4; i++){
        for(int j=0; j<4; j++){
            cin>>m1[i][j];
        }
    }
    
cout<<"Insira os valores da segunda matriz: ";
    for(int i=0; i<4; i++){
        for(int j=0; j<4; j++){
            cin>>m2[i][j];
        }
    }
    
    for(int i=0; i<4; i++){
        for(int j=0; j<4; j++){
            soma[i][j]= m1[i][j]+m2[i][j];
            
        }
    }
cout<<"A soma das matrizes é: "<<endl;
    for(int i=0; i<4; i++){
        for(int j=0; j<4; j++){
            cout<<soma[i][j]<<" "<<endl;
        }
    }
    bool iguais=true;
     for(int i=0; i<4; i++){
         if(soma[i][i]!= soma [i][3-i]){
             iguais=false;
         }
     }
    if(iguais){
        cout<<"As diagonais são iguais";
    }else{
        cout<<"As diagonais não são iguais";
    }

      return 0;
}
